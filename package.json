{
  "name": "oosatyabhama-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "set-admin": "node scripts/set-admin.mjs",
    "seed": "node scripts/seed-products.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
